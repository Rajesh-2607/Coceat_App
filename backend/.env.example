# Copy to .env and fill in real values. Never commit .env.
# In production these are set in the Render dashboard; there is no .env file on servers.

# development | test | staging | production
APP_ENV=development
# python -c "import secrets; print(secrets.token_urlsafe(64))"  (>= 32 chars required in production)
SESSION_SECRET=change-me-generate-with-python-secrets-token-urlsafe-64
# Neon POOLED connection string, logging in as the non-owner app role (RLS applies to it)
DATABASE_URL=postgresql+psycopg://cocreat_app:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/cocreat?sslmode=require
# Neon DIRECT connection string, owner role; used only by Alembic migrations
DATABASE_URL_DIRECT=postgresql+psycopg://neondb_owner:password@ep-xxxx.ap-southeast-1.aws.neon.tech/cocreat?sslmode=require
# Name of the app role above; migrations grant it table access
DB_APP_ROLE=cocreat_app
# Connections per worker = DB_POOL_SIZE + DB_MAX_OVERFLOW
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
CORS_ORIGINS=["http://localhost:5173"]
# Leave empty for a host-only cookie (recommended)
COOKIE_DOMAIN=
SESSION_TTL_DAYS=30
# Proxies appending to X-Forwarded-For in front of the API. Local: 0. Render: 1 (verify on staging).
TRUSTED_PROXY_HOPS=0

# DLT-registered SMS provider (MSG91 flow API by default)
SMS_API_KEY=your-sms-provider-key
SMS_SENDER_ID=CCREAT
SMS_OTP_TEMPLATE_ID=your-dlt-template-id
# true ONLY locally: accepts OTP 123456 and sends no SMS. Refused at startup in production.
OTP_DEV_MODE=true

R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=cocreat-dev

# Optional error tracking; empty disables Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=INFO
