# Free single-service deployment (Render free web service + Neon free database).
# Copy these into the Render dashboard. Never commit real values. Source of truth: backend/app/core/config.py.

# --- plain settings (already set in render.yaml) ---------------------------------------------
APP_ENV=production
OTP_DEV_MODE=false
WEB_CONCURRENCY=1
TRUSTED_PROXY_HOPS=1
DB_APP_ROLE=cocreat_app
# The address Render gives your service after the first deploy. Must be https.
CORS_ORIGINS=["https://your-service-name.onrender.com"]

# --- secrets (enter in the Render dashboard) --------------------------------------------------
# At least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=change-me-at-least-32-characters-long-random
# Neon: pooled host (with -pooler) for the app role, and the direct host for migrations
DATABASE_URL=postgresql+psycopg://cocreat_app:change-me@your-neon-pooler-host/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql+psycopg://cocreat_owner:change-me@your-neon-direct-host/neondb?sslmode=require

# SMS for real OTP login (OTP_DEV_MODE must stay false in production)
SMS_API_KEY=change-me
SMS_SENDER_ID=change-me
SMS_OTP_TEMPLATE_ID=change-me

# Cloudflare R2: required at startup even if file storage is not used yet
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=change-me
